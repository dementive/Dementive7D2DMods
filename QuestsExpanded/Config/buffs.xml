<Dementive>

	<append xpath="/buffs">
		<!-- Bosses of the defense quests (WaveDirectorDEM in QuestsExpanded.dll): tougher, bigger, explosion
		resistant, with a health bar overhead and a marker on the map and compass. Max health only goes up after the
		buff starts, so health is topped up to the new max then, like vanilla's tough Twitch vote zombies. -->
		<buff name="buffDementiveBoss" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>

			<effect_group>
				<passive_effect name="HealthMax" operation="perc_add" value="1.5"/>
				<passive_effect name="ExplosionIncomingDamage" operation="perc_add" value="-0.5"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="30000"/>
				<triggered_effect trigger="onSelfBuffStart" action="SetScale" scale="1.2"/>
				<triggered_effect trigger="onSelfBuffStart" action="SetNavObject" nav_object="twitch_vote_boss" add="true"/>
				<triggered_effect trigger="onSelfBuffStart" action="SetNavObject" nav_object="zombie" add="true"/>
			</effect_group>
		</buff>

		<!-- The last few zombies of a defense wave: shown on the map and compass so nobody has to hunt for them -->
		<buff name="buffDementiveMarked" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="SetNavObject" nav_object="zombie" add="true"/>
			</effect_group>
		</buff>

		<!-- The boss that hunts a player on the last stage of a contract, on top of buffDementiveBoss -->
		<buff name="buffDementiveContractBoss" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>

			<effect_group>
				<passive_effect name="HealthMax" operation="perc_add" value="1"/>
				<passive_effect name="EntityDamage" operation="perc_add" value=".25"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyStats" stat="Health" operation="add" value="30000"/>
			</effect_group>
		</buff>

		<!-- A player on a contract: their gamestage goes up with every stage done (ContractsDEM sets the cvar) -->
		<buff name="buffDementiveContract" name_key="buffDementiveContractName" description_key="buffDementiveContractDesc" tooltip_key="buffDementiveContractName" icon="ui_game_symbol_skull" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>

			<effect_group>
				<passive_effect name="GameStage" operation="perc_add" value="@dementiveContractGS"/>
			</effect_group>
		</buff>

		<!-- Contract boons, one picked from three after every stage; they last until the contract ends -->
		<buff name="buffDementiveBoon_deadeye" name_key="buffDementiveBoon_deadeyeName" description_key="buffDementiveBoon_deadeyeDesc" tooltip_key="buffDementiveBoon_deadeyeName" icon="ui_game_symbol_head_shot" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="EntityDamage" operation="perc_add" value=".15"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_bloodthirst" name_key="buffDementiveBoon_bloodthirstName" description_key="buffDementiveBoon_bloodthirstDesc" tooltip_key="buffDementiveBoon_bloodthirstName" icon="ui_game_symbol_siphoning_strikes" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<triggered_effect trigger="onSelfKilledOther" action="ModifyStats" stat="Health" operation="add" value="10"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_secondwind" name_key="buffDementiveBoon_secondwindName" description_key="buffDementiveBoon_secondwindDesc" tooltip_key="buffDementiveBoon_secondwindName" icon="ui_game_symbol_cardio" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".5"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_scavenger" name_key="buffDementiveBoon_scavengerName" description_key="buffDementiveBoon_scavengerDesc" tooltip_key="buffDementiveBoon_scavengerName" icon="ui_game_symbol_mother_load" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="LootStage" operation="perc_add" value=".15"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_ironhide" name_key="buffDementiveBoon_ironhideName" description_key="buffDementiveBoon_ironhideDesc" tooltip_key="buffDementiveBoon_ironhideName" icon="ui_game_symbol_armor_iron" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="10"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_fleetfoot" name_key="buffDementiveBoon_fleetfootName" description_key="buffDementiveBoon_fleetfootDesc" tooltip_key="buffDementiveBoon_fleetfootName" icon="ui_game_symbol_run" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_add" value=".1"/>
				<passive_effect name="WalkSpeed" operation="perc_add" value=".1"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_regeneration" name_key="buffDementiveBoon_regenerationName" description_key="buffDementiveBoon_regenerationDesc" tooltip_key="buffDementiveBoon_regenerationName" icon="ui_game_symbol_healing_factor" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_add" value=".2"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_glasscannon" name_key="buffDementiveBoon_glasscannonName" description_key="buffDementiveBoon_glasscannonDesc" tooltip_key="buffDementiveBoon_glasscannonName" icon="ui_game_symbol_critical" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="EntityDamage" operation="perc_add" value=".3"/>
				<passive_effect name="HealthMax" operation="perc_add" value="-.2"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_adrenaline" name_key="buffDementiveBoon_adrenalineName" description_key="buffDementiveBoon_adrenalineDesc" tooltip_key="buffDementiveBoon_adrenalineName" icon="ui_game_symbol_steroids" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_add" value=".2"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".5"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="-15"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveBoon_juggernaut" name_key="buffDementiveBoon_juggernautName" description_key="buffDementiveBoon_juggernautDesc" tooltip_key="buffDementiveBoon_juggernautName" icon="ui_game_symbol_muscle" icon_color="255,190,60">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<passive_effect name="HealthMax" operation="perc_add" value=".25"/>
				<passive_effect name="PhysicalDamageResist" operation="base_add" value="15"/>
				<passive_effect name="RunSpeed" operation="perc_add" value="-.15"/>
			</effect_group>
		</buff>

	</append>

</Dementive>
