<Dementive>

	<append xpath="/lootcontainers/lootprobtemplates">
		<!-- Chance per container opened that one weapon drops -->
		<lootprobtemplate name="DementiveRaresT1">
			<loot level="1,999999" prob="0.005"/>  <!-- 1 / 200 -->
		</lootprobtemplate>
		<lootprobtemplate name="DementiveRaresT2">
			<loot level="1,999999" prob="0.01"/>  <!-- 1 / 100 -->
		</lootprobtemplate>
		<lootprobtemplate name="DementiveRaresT3">
			<loot level="1,999999" prob="0.02"/>  <!-- 1 / 50 -->
		</lootprobtemplate>
		<lootprobtemplate name="DementiveRaresT4">
			<loot level="1,999999" prob="0.04"/>  <!-- 1 / 25 -->
		</lootprobtemplate>
		<lootprobtemplate name="DementiveRaresT5">
			<loot level="1,999999" prob="0.05"/>  <!-- 1 / 20 -->
		</lootprobtemplate>

		<!-- Quest rewards: the reward "value" is the quest tier. At tiers 4-6 roughly 3% of schematic rewards
		     (about 1 in 20 quests) offer one of the weapons instead -->
		<lootprobtemplate name="DementiveQuestRewards">
			<loot level="0,3" prob="0"/>
			<loot level="4,7" prob="0.06"/>
		</lootprobtemplate>
	</append>
	
	
