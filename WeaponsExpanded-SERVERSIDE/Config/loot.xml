	<append xpath="/lootcontainers/lootgroup[@name='groupFireTruck03']">
		<item group="groupDementiveAxes" loot_prob_template="DementiveRaresT3" force_prob="true"/>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupToolsT3']">
		<item group="groupDementiveTools" loot_prob_template="DementiveRaresT3" force_prob="true"/>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupQuestToolsT3']">
		<item group="groupDementiveTools" loot_prob_template="DementiveRaresT3" force_prob="true"/>
	</append>
	
		<!-- Lootable from the following -->
	<append xpath="//lootgroup[@name='groupSmallSafeLoot']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT2" force_prob="true"/>
	</append>
	<append xpath="//lootgroup[@name='groupGunSafeSecure']">
		<item group="groupDementiveRanged" loot_prob_template="DementiveRaresT4" force_prob="true"/>
		<item group="groupDementiveBots" loot_prob_template="DementiveRaresT4" force_prob="true"/>
	</append>
	
	<!-- Locked Iron Chest -->
	<append xpath="//lootgroup[@name='groupReinforcedChestT3']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT3" force_prob="true"/>
	</append>
	<!-- Locked Small Hardened Chest -->
	<append xpath="//lootgroup[@name='groupHardenedChestT4']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT4" force_prob="true"/>
	</append>
	<!-- Locked Large Hardened Chest -->
	<append xpath="//lootgroup[@name='groupHardenedChestT5']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT5" force_prob="true"/>
	</append>
	
	<append xpath="//lootgroup[@name='groupZpackBoss']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT3" force_prob="true"/>
	</append>
	<append xpath="//lootgroup[@name='groupZpackStrong']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT2" force_prob="true"/>
	</append>
	<append xpath="//lootgroup[@name='groupZpackReg']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT1" force_prob="true"/>
	</append>
	
	<append xpath="//lootgroup[@name='groupHiddenStash']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT2" force_prob="true"/>
	</append>
	
	<append xpath="//lootgroup[@name='groupBuriedWeaponChest']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT2" force_prob="true"/>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupQuestSchematics']">
		<item group="groupDementiveAll" loot_prob_template="DementiveQuestRewards"/>
	</append>

	<append xpath="//lootgroup[@name='groupBuriedTreasure']">
		<item group="groupDementiveAll" loot_prob_template="DementiveRaresT3" force_prob="true"/>
