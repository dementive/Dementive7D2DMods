				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveEnergyDisplay" operation="divide" value="@$MetabolismDuration"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDementiveEnergy">
					<requirement name="CVarCompare" cvar="$buffDementiveEnergyDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffDementiveEnergyDisplay" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDementiveEnergyDuration" operation="set" value="0"/>
			</effect_group>

			<effect_group>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".15"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveCrash" name_key="buffDementiveCrash" description_key="buffDementiveCrashDesc" icon="ui_game_symbol_pills" icon_color="255,128,0">
			<stack_type value="replace"/>
			<duration value="120"/>
			<display_value value="duration"/>
			<effect_group>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="-.5"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Blur" intensity=".35" fade="2"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyScreenEffect" effect_name="Blur" intensity=".35" fade="2"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Blur" intensity="0" fade="2"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveOverdose" name_key="buffDementiveOverdose" description_key="buffDementiveOverdoseDesc" icon="ui_game_symbol_skull" icon_color="255,0,0">
			<stack_type value="ignore"/>
			<duration value="3"/>
			<display_value value="duration"/>
			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_set" value="0"/>
				<passive_effect name="WalkSpeed" operation="perc_set" value="0"/>
				<passive_effect name="CrouchSpeed" operation="perc_set" value="0"/>
				<passive_effect name="JumpStrength" operation="perc_set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="Ragdoll" duration="2.5"/>
				<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="player#painlg"/>
				<triggered_effect trigger="onSelfBuffStart" action="DementiveOverdose, ConsumablesExpanded"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveLongHaul" name_key="DementiveLongHaul" description_key="buffDementiveLongHaulDesc" icon="ui_game_symbol_run">
			<stack_type value="replace"/>
			<duration value="60"/>
			<display_value value="duration"/>
			<effect_group>
				<passive_effect name="StaminaLoss" operation="base_set" value="0"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Stamina" operation="set" value="500"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
			</effect_group>
		</buff>

		<!-- The cvar is what the C# reads, on the server too: see ChemPossumDEM -->
		<buff name="buffDementivePossum" name_key="DementivePossumPills" description_key="buffDementivePossumDesc" icon="ui_game_symbol_near_death_trauma">
			<stack_type value="replace"/>
			<duration value="8"/>
			<display_value value="duration"/>
			<effect_group>
				<passive_effect name="DisableMovement" operation="base_set" value="1"/>
				<passive_effect name="Mobility" operation="base_set" value="0"/>
				<passive_effect name="RunSpeed" operation="perc_set" value="0"/>
				<passive_effect name="WalkSpeed" operation="perc_set" value="0"/>
				<passive_effect name="CrouchSpeed" operation="perc_set" value="0"/>
				<passive_effect name="JumpStrength" operation="perc_set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="%dementivePlayingDead" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="Ragdoll" duration="7.5"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Greyscale" intensity=".8" fade="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Dark" intensity=".5" fade="1"/>
				<triggered_effect trigger="onSelfAttackedOther" action="AddBuff" buff="buffDementiveCrash"/>
				<triggered_effect trigger="onSelfAttackedOther" action="RemoveBuff" buff="buffDementivePossum"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="%dementivePlayingDead" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Greyscale" intensity="0" fade="1"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Dark" intensity="0" fade="1"/>
				<triggered_effect trigger="onSelfLeaveGame" action="RemoveBuff" buff="buffDementivePossum"/>
			</effect_group>
		</buff>

		<!-- The C# absorbs the hits and keeps the bill: see ChemDamageDEM -->
		<buff name="buffDementiveOnMyTab" name_key="DementiveOnMyTab" description_key="buffDementiveOnMyTabDesc" icon="ui_game_symbol_armor_iron">
			<stack_type value="replace"/>
			<duration value="15"/>
			<display_value value="duration"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$dementiveTabOwed" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="%dementiveOnTab" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Greyscale" intensity=".35" fade="1"/>
				<triggered_effect trigger="onSelfBuffFinish" action="DementiveTabBill, ConsumablesExpanded"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="%dementiveOnTab" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Greyscale" intensity="0" fade="1"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveDeadMansSwitch" name_key="DementiveDeadMansSwitch" description_key="buffDementiveDeadMansSwitchDesc" icon="ui_game_symbol_critical">
			<stack_type value="replace"/>
			<duration value="1800"/>
			<display_value value="duration"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="%dementiveSwitchLoaded" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="%dementiveSwitchLoaded" operation="set" value="0"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveSwitchFired" name_key="buffDementiveSwitchFired" description_key="buffDementiveSwitchFiredDesc" icon="ui_game_symbol_critical" icon_color="255,0,0">
			<stack_type value="replace"/>
			<duration value="3"/>
			<display_value value="duration"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="%dementiveShielded" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="player#painlg"/>
				<triggered_effect trigger="onSelfBuffStart" action="ShowToolbeltMessage" message_key="buffDementiveSwitchFiredMessage"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Greyscale" intensity=".6" fade=".2"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="%dementiveShielded" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Greyscale" intensity="0" fade="1"/>
			</effect_group>
		</buff>

		<!-- About 8 real seconds: buff time runs on game time, which is at 35% here. The slowdown itself is in ChemTimeDEM -->
		<buff name="buffDementiveNickSolo" name_key="DementiveNickOfTime" description_key="buffDementiveNickSoloDesc" icon="ui_game_symbol_clock">
			<stack_type value="replace"/>
			<duration value="2.8"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Greyscale" intensity=".5" fade=".2"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Greyscale" intensity="0" fade=".5"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveNickCoop" name_key="DementiveNickOfTime" description_key="buffDementiveNickCoopDesc" icon="ui_game_symbol_clock">
			<stack_type value="replace"/>
			<duration value="8"/>
			<display_value value="duration"/>
			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_add" value=".6"/>
				<passive_effect name="WalkSpeed" operation="perc_add" value=".6"/>
				<passive_effect name="ReloadSpeedMultiplier" operation="perc_add" value=".6"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffDementiveCrash"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveGinSway" hidden="true">
			<stack_type value="replace"/>
			<duration value="90"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyScreenEffect" effect_name="Drunk" intensity=".3" fade="4"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyScreenEffect" effect_name="Drunk" intensity=".3" fade="4"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyScreenEffect" effect_name="Drunk" intensity="0" fade="4"/>
			</effect_group>
		</buff>

	    <buff name="buffDrugHerbalPainkillers" name_key="buffDrugHerbalPainkillersName" description_key="buffDrugHerbalPainkillersDesc" icon="ui_game_symbol_pills">
		    <stack_type value="replace"/><duration value="0"/>
		    <display_value value=".buffDrugHerbalPainkillersDisplay"/><display_value_format value="time"/>
		    <effect_group>
			    <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffDrugHerbalPainkillersDuration" operation="subtract" value="@$MetabolismDuration"/>
			    <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDrugHerbalPainkillersDisplay" operation="set" value="@$buffDrugHerbalPainkillersDuration"/>
			    <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDrugHerbalPainkillersDisplay" operation="divide" value="@$MetabolismDuration"/>
		    </effect_group>
		    <effect_group>
			    <triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDrugHerbalPainkillers">
				    <requirement name="CVarCompare" cvar="$buffDrugHerbalPainkillersDuration" operation="LTE" value="0"/>
			    </triggered_effect>
			    <triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffDrugHerbalPainkillersDisplay" operation="set" value="0"/>
			    <triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDrugHerbalPainkillersDuration" operation="set" value="0"/>
			    <triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDrugHerbalPainkillersHealed" operation="set" value="0"/>
		    </effect_group>

		    <effect_group>
			    <requirement name="!HasBuff" buff="buffInjuryConcussion"/>
			    <requirement name="CVarCompare" cvar="$buffDrugHerbalPainkillersHealed" operation="Equals" value="0"/>
				    <triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="20"/>
				    <triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffDrugHerbalPainkillersHealed" operation="set" value="1"/>
		    </effect_group>

		    <effect_group>
			    <passive_effect name="HealthLoss" operation="perc_add" value="-.1"/>
			    <passive_effect name="WaterChangeOT" operation="base_subtract" value="0.109"/>
			    <passive_effect name="BuffResistance" operation="base_add" value=".5" tags="buffInjuryStunned01CHTrigger,buffInjuryStunned00,buffInjuryStunned01,buffInjuryStunned01Shotgun,buffInjuryStunned02,buffInjuryStunned02Shotgun,buffInjuryStunned03,buffInjuryStunned03Shotgun"/>
		    </effect_group>
	    </buff>

		<buff name="buffAppleMegaCrush" name_key="buffAppleMegaCrush" description_key="buffAppleMegaCrushDesc" icon="ui_game_symbol_candy_eye_candy">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffAppleMegaCrushDisplay"/>
			<display_value_format value="time"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffAppleMegaCrushDuration" operation="subtract" value="@$MetabolismDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffAppleMegaCrushDisplay" operation="set" value="@$buffAppleMegaCrushDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffAppleMegaCrushDisplay" operation="divide" value="@$MetabolismDuration"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAppleMegaCrush">
					<requirement name="CVarCompare" cvar="$buffAppleMegaCrushDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffAppleMegaCrushDisplay" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffAppleMegaCrushDuration" operation="set" value="0"/>
			</effect_group>

			<!-- The search and lockpick cuts are shares of the time the perks (and a vanilla helmet) leave, like vanilla's
			     own cuts, which stop at 99%: a flat cut on top of them pushed the time to zero or below, and then the
			     search or lockpick never finishes. .DementiveScavHelmet is the helmet's cut (items.xml) -->
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".1">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="1"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".2">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="2"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".4">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="3"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".6">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="4"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".79">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="5"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value="@.DementiveScavHelmet"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="set" value="0">
					<requirement name="CVarCompare" cvar=".DementiveScavCandy" operation="LT" value="0"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveScavCandy" operation="multiply" value="-.5"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".1">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="1"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".2">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="2"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".4">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="3"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".6">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="4"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value=".79">
					<requirement name="ProgressionLevel" progression_name="perkLuckyLooter" operation="Equals" value="5"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="subtract" value="@.DementiveScavHelmet"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="set" value="0">
					<requirement name="CVarCompare" cvar=".DementiveScavCandy" operation="LT" value="0"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".DementiveScavCandy" operation="multiply" value="-.5"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".DementiveScavCandy" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveLockCandy" operation="set" value="1"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveLockCandy" operation="subtract" value=".17">
					<requirement name="ProgressionLevel" progression_name="perkLockPicking" operation="Equals" value="1"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveLockCandy" operation="subtract" value=".2725">
					<requirement name="ProgressionLevel" progression_name="perkLockPicking" operation="Equals" value="2"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveLockCandy" operation="subtract" value=".375">
					<requirement name="ProgressionLevel" progression_name="perkLockPicking" operation="Equals" value="3"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".DementiveLockCandy" operation="subtract" value=".167">
					<requirement name="ProgressionLevel" progression_name="perkGreatHeistComplete" operation="Equals" value="1"/></triggered_effect>
