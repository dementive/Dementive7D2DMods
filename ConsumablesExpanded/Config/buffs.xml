<Dementive>
	<append xpath="/buffs">
		<buff name="buffDementiveHot" name_key="buffDementiveHot" description_key="buffDementiveHotDesc" icon="ui_game_symbol_campfire">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffDementiveHotDisplay"/>
			<display_value_format value="time"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffDementiveHotDuration" operation="subtract" value="@$MetabolismDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveHotDisplay" operation="set" value="@$buffDementiveHotDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveHotDisplay" operation="divide" value="@$MetabolismDuration"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDementiveHot">
					<requirement name="CVarCompare" cvar="$buffDementiveHotDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffDementiveHotDisplay" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDementiveHotDuration" operation="set" value="0"/>
			</effect_group>

			<effect_group>
				<passive_effect name="HypothermalResist" operation="base_add" value="10"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveCool" name_key="buffDementiveCool" description_key="buffDementiveCoolDesc" icon="ui_game_symbol_water">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffDementiveCoolDisplay"/>
			<display_value_format value="time"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffDementiveCoolDuration" operation="subtract" value="@$MetabolismDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveCoolDisplay" operation="set" value="@$buffDementiveCoolDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveCoolDisplay" operation="divide" value="@$MetabolismDuration"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDementiveCool">
					<requirement name="CVarCompare" cvar="$buffDementiveCoolDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffDementiveCoolDisplay" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDementiveCoolDuration" operation="set" value="0"/>
			</effect_group>

			<effect_group>
				<passive_effect name="HyperthermalResist" operation="base_add" value="10"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveFilling" name_key="buffDementiveFilling" description_key="buffDementiveFillingDesc" icon="ui_game_symbol_stomach">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffDementiveFillingDisplay"/>
			<display_value_format value="time"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$buffDementiveFillingDuration" operation="subtract" value="@$MetabolismDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveFillingDisplay" operation="set" value="@$buffDementiveFillingDuration"/>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffDementiveFillingDisplay" operation="divide" value="@$MetabolismDuration"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffDementiveFilling">
					<requirement name="CVarCompare" cvar="$buffDementiveFillingDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffDementiveFillingDisplay" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar="$buffDementiveFillingDuration" operation="set" value="0"/>
			</effect_group>

			<effect_group>
				<passive_effect name="FoodLossPerStaminaPointGained" operation="perc_add" value="-.15"/>
				<passive_effect name="WaterLossPerStaminaPointGained" operation="perc_add" value="-.15"/>
			</effect_group>
		</buff>

		<buff name="buffDementiveEnergy" name_key="buffDementiveEnergy" description_key="buffDementiveEnergyDesc" icon="ui_game_symbol_coffee">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffDementiveEnergyDisplay"/>
