<Dementive>

	<!-- Snowberries are a wild-only plant in vanilla. These patches make them a farmable crop that
	     follows the same block chain as vanilla blueberries (seed -> growing -> player harvest). -->

	<!-- Seed: plantable, unlocked by the Seeds crafting skill -->
	<set xpath="/blocks/block[@name='plantedSnowberry1']/property[@name='CreativeMode']/@value">Player</set>
	<set xpath="/blocks/block[@name='plantedSnowberry1']/property[@name='UnlockedBy']/@value">craftingSeeds</set>
	<append xpath="/blocks/block[@name='plantedSnowberry1']">
		<property name="Tags" value="seedSkill"/>
		<property name="SoundPickup" value="seeds_generic1_grab"/>
		<property name="SoundPlace" value="seeds_generic1_place"/>
	</append>

	<!-- Player-planted snowberries grow into the player harvest block, like blueberries -->
	<set xpath="/blocks/block[@name='plantedSnowberry2']/property[@class='PlantGrowing']/property[@name='Next']/@value">plantedSnowberry3HarvestPlayer</set>

	<!-- Wild snowberries become a harvestable crop that drops berries instead of fibers -->
	<set xpath="/blocks/block[@name='plantedSnowberry3Harvest']/property[@name='Extends']/@value">cropsHarvestableMaster</set>
	<removeattribute xpath="/blocks/block[@name='plantedSnowberry3Harvest']/property[@name='Extends']/@param1"/>
	<remove xpath="/blocks/block[@name='plantedSnowberry3Harvest']/drop[@event='Harvest']"/>
	<append xpath="/blocks/block[@name='plantedSnowberry3Harvest']">
		<drop event="Harvest" name="foodCropSnowberry" count="1" tag="wildCropsHarvest"/>
		<drop event="Harvest" name="foodCropSnowberry" prob="0.5" count="1" tag="bonusCropHarvest"/>
		<drop event="Harvest" name="foodCropSnowberry" count="1" tag="farmerBonusHarvest"/>
	</append>

	<append xpath="/blocks/block[@name='plantedSnowberry3HarvestPlayer']">
		<drop event="Harvest" name="foodCropSnowberry" count="2" tag="cropHarvest"/>
		<drop event="Harvest" name="foodCropSnowberry" prob="0.5" count="1" tag="bonusCropHarvest"/>
		<drop event="Harvest" name="foodCropSnowberry" count="1" tag="farmerBonusHarvest"/>
		<drop event="Harvest" name="plantedSnowberry1" count="1" tag="farmerBonusSeed"/>
		<drop event="Destroy" name="plantedSnowberry1" count="1" prob="0.5"/>
	</append>

</Dementive>
