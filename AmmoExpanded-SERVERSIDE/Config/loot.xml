<Dementive>

	<append xpath="/lootcontainers/lootprobtemplates">
		<!-- Loose rounds in ammo loot: a quarter as likely as a vanilla HP (tier 2) or AP (tier 3) round once the loot
		     stage reaches the level those start dropping at -->
		<lootprobtemplate name="DementiveAmmoLootT2">
			<loot level="0,29" prob="0"/>
			<loot level="30,999999" prob="0.25"/>
		</lootprobtemplate>
		<lootprobtemplate name="DementiveAmmoLootT3">
			<loot level="0,87" prob="0"/>
			<loot level="88,999999" prob="0.25"/>
		</lootprobtemplate>
	</append>

	<!-- Schematics drop alongside the vanilla mod schematics, together about as often as three of those -->
	<insertBefore xpath="/lootcontainers/lootgroup[@name='schematicsModsAndGeneralT0']">
		<lootgroup name="groupDementiveAmmoSchematicsT1">
			<item name="DementiveAmmo9mmIncendiarySchematic"/>
			<item name="DementiveAmmo44IncendiarySchematic"/>
			<item name="DementiveAmmo762IncendiarySchematic"/>
			<item name="DementiveAmmo9mmFrangibleSchematic"/>
			<item name="DementiveAmmo44FrangibleSchematic"/>
			<item name="DementiveAmmo762FrangibleSchematic"/>
			<item name="DementiveAmmoShotgunBeanBagSchematic"/>
			<item name="DementiveAmmoArrowBarbedSchematic"/>
			<item name="DementiveAmmoBoltBarbedSchematic"/>
			<item name="DementiveAmmoArrowBluntSchematic"/>
			<item name="DementiveAmmoBoltBluntSchematic"/>
		</lootgroup>
		<lootgroup name="groupDementiveAmmoSchematicsT2">
			<item name="DementiveAmmo762MatchSchematic"/>
			<item name="DementiveAmmo44ExplosiveSchematic"/>
			<item name="DementiveAmmoShotgunDragonsBreathSchematic"/>
			<item name="DementiveAmmoShotgunFlechetteSchematic"/>
		</lootgroup>
	</insertBefore>
	<append xpath="/lootcontainers/lootgroup[@name='schematicsModsAndGeneralT1']">
		<item group="groupDementiveAmmoSchematicsT1" prob="3"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='schematicsModsAndGeneralT2']">
		<item group="groupDementiveAmmoSchematicsT2" prob="3"/>
	</append>

