				<passive_effect name="CraftingTime" operation="perc_add" value="-.3,-.4,-.5,-.6,-.7,-.8" tier="1,2,3,4,5,6" tags="cookingPotFood">
					<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="EQ" value="3"/>
				</passive_effect>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.3,-.4,-.5,-.6,-.7,-.8" tier="1,2,3,4,5,6" tags="cookingPotChem"/>
				<display_value name="dCraftingTime" value="-.299,-.4,-.5,-.599,-.7,-.8" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item>
		<item name="DementiveStationToolCookingGrill">
			<property name="Extends" value="toolCookingGrill" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationToolCookingGrill" />
			<property name="DescriptionKey" value="DementiveStationToolCookingGrillDesc" />
			<property name="EconomicValue" value="1500" />
			<property name="SellableToTrader" value="true" />
			<property name="TraderStageTemplate" value="baseTier2" />
