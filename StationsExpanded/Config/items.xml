			</effect_group>
			<effect_group>
				<requirement name="ItemHasTags" tags="toolCookingGrill"/>
				<requirement name="!IsHeldItem"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-1.5,-2,-2.5,-3,-3.5,-4" tier="1,2,3,4,5,6" tags="grill">
					<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="EQ" value="0"/>
				</passive_effect>
				<passive_effect name="CraftingTime" operation="perc_add" value="-0.9,-1.2,-1.5,-1.8,-2.1,-2.4" tier="1,2,3,4,5,6" tags="grill">
					<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="EQ" value="1"/>
				</passive_effect>
				<passive_effect name="CraftingTime" operation="perc_add" value="-0.6,-0.8,-1,-1.2,-1.4,-1.6" tier="1,2,3,4,5,6" tags="grill">
					<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="EQ" value="2"/>
				</passive_effect>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.3,-.4,-.5,-.6,-.7,-.8" tier="1,2,3,4,5,6" tags="grill">
					<requirement name="ProgressionLevel" progression_name="perkMasterChef" operation="EQ" value="3"/>
				</passive_effect>
				<display_value name="dCraftingTime" value="-.299,-.4,-.5,-.599,-.7,-.8" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item>
		<item name="DementiveStationToolBeaker">
			<property name="Extends" value="toolBeaker" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationToolBeaker" />
			<property name="DescriptionKey" value="DementiveStationToolBeakerDesc" />
			<property name="EconomicValue" value="2000" />
			<property name="SellableToTrader" value="true" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="StationToolBase" value="toolBeaker" />
			<property name="StationToolCraftTime" value="0.75" />
			<property name="StationToolExtraChance" value="0.15" />
			<property name="Stacknumber" value="1" />
		</item>
	</append>
</configs>
