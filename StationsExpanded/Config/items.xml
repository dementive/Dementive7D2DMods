<configs>
	<append xpath="/items">
		<!-- Named station tools (generated by Scripts/StationsExpanded/gen_stations.py). Each extends its vanilla
		     tool and carries copies of its effect groups (they aren't inherited). StationToolBase lets it go in
		     that tool's slot and count for its recipes; StationToolCraftTime and StationToolExtraChance apply to
		     the recipes that need the vanilla tool (all recipes at the station with StationToolScope all) while
		     it sits in the station. -->
		<item name="DementiveStationToolAnvil">
			<property name="Extends" value="toolAnvil" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationToolAnvil" />
			<property name="DescriptionKey" value="DementiveStationToolAnvilDesc" />
			<property name="EconomicValue" value="2500" />
			<property name="SellableToTrader" value="true" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="StationToolBase" value="toolAnvil" />
			<property name="StationToolCraftTime" value="0.75" />
			<property name="StationToolExtraChance" value="0.1" />
			<property name="StationToolScope" value="all" />
			<effect_group>
				<passive_effect name="ModSlots" operation="base_set" value="0"/>
				<passive_effect name="DegradationMax" operation="base_set" value="10,60" tier="1,6"/>
			</effect_group>
			<effect_group>
				<requirement name="ItemHasTags" tags="toolAnvil"/>
				<requirement name="!IsHeldItem"/>
				<passive_effect name="CraftingTime" operation="perc_add" value="-.2,-.3,-.4,-.5,-.6,-.7" tier="1,2,3,4,5,6"/>
				<display_value name="dCraftingTime" value=".2,.3,.4,.5,.6,.7" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item>
		<item name="DementiveStationToolBellows">
			<property name="Extends" value="toolBellows" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationToolBellows" />
			<property name="DescriptionKey" value="DementiveStationToolBellowsDesc" />
			<property name="EconomicValue" value="3000" />
			<property name="SellableToTrader" value="true" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="StationToolBase" value="toolBellows" />
			<effect_group>
				<passive_effect name="ModSlots" operation="base_set" value="0"/>
				<passive_effect name="DegradationMax" operation="base_set" value="10,60" tier="1,6"/>
			</effect_group>
			<effect_group>
				<passive_effect name="CraftingSmeltTime" operation="perc_add" value="-.46,-.57,-.67,-.75,-.82,-.89" tier="1,2,3,4,5,6"/>
				<display_value name="dCraftingSmeltTime" value="-.46,-.57,-.67,-.75,-.82,-.89" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item>
		<item name="DementiveStationToolCrucible">
			<property name="Extends" value="toolForgeCrucible" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationToolCrucible" />
			<property name="DescriptionKey" value="DementiveStationToolCrucibleDesc" />
			<property name="EconomicValue" value="12000" />
			<property name="SellableToTrader" value="true" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="StationToolBase" value="toolForgeCrucible" />
			<property name="StationToolCraftTime" value="0.75" />
			<property name="StationToolExtraChance" value="0.15" />
		</item>
		<item name="DementiveStationToolCookingPot">
			<property name="Extends" value="toolCookingPot" param1="UnlockedBy,TraderStageTemplate" />
