<configs>
	<append xpath="/blocks">
		<!-- Generated by Scripts/StationsExpanded/gen_stations.py. Every named station extends its vanilla station,
		     so it keeps the same model, recipes, window, tool slots and fuel. It must name the vanilla window
		     (WorkstationWindow) and must not set WorkstationName, which would replace the vanilla station's
		     crafting data. Its bonuses are read by StationBonusDEM: StationCraftTime multiplies crafting time,
		     StationQualityChance is the chance a finished item with quality comes out one level higher,
		     StationExtraChance the chance a craft comes out twice, StationFuelTime multiplies how long fuel
		     burns and StationSmeltSpeed how fast it smelts. Named collectors change the vanilla collector
		     settings. Everything here is found, not crafted, so it doesn't inherit the vanilla unlock or trader
		     stage (rare stock from trader stage 50). -->
		<block name="DementiveStationWorkbench">
			<property name="Extends" value="workbench" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationWorkbench" />
			<property name="DescriptionKey" value="DementiveStationWorkbenchDesc" />
			<property name="EconomicValue" value="6000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="WorkstationWindow" value="workstation_workbench" />
			<property name="StationCraftTime" value="0.8" />
			<property name="StationQualityChance" value="0.1" />
		</block>
		<block name="DementiveStationForge">
			<property name="Extends" value="forge" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationForge" />
			<property name="DescriptionKey" value="DementiveStationForgeDesc" />
			<property name="EconomicValue" value="6000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="WorkstationWindow" value="workstation_forge" />
			<property name="StationSmeltSpeed" value="1.5" />
			<property name="StationFuelTime" value="1.25" />
		</block>
		<block name="DementiveStationChemistry">
			<property name="Extends" value="chemistryStation" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationChemistry" />
			<property name="DescriptionKey" value="DementiveStationChemistryDesc" />
			<property name="EconomicValue" value="8000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="WorkstationWindow" value="workstation_chemistryStation" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="chemistryStation" />
			</property>
			<property name="StationCraftTime" value="0.8" />
			<property name="StationExtraChance" value="0.15" />
		</block>
		<block name="DementiveStationCementMixer">
			<property name="Extends" value="cementMixer" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationCementMixer" />
			<property name="DescriptionKey" value="DementiveStationCementMixerDesc" />
			<property name="EconomicValue" value="5000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="WorkstationWindow" value="workstation_cementMixer" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="cementMixer" />
			</property>
			<property name="StationCraftTime" value="0.5" />
			<property name="StationExtraChance" value="0.1" />
		</block>
		<block name="DementiveStationCampfire">
			<property name="Extends" value="campfire" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationCampfire" />
			<property name="DescriptionKey" value="DementiveStationCampfireDesc" />
			<property name="EconomicValue" value="3000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="WorkstationWindow" value="workstation_campfire" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="campfire" />
			</property>
			<property name="StationCraftTime" value="0.75" />
			<property name="StationFuelTime" value="2" />
			<property name="StationExtraChance" value="0.1" />
		</block>
		<block name="DementiveStationDewCollector">
			<property name="Extends" value="cntDewCollector" param1="UnlockedBy,TraderStageTemplate" />
			<property name="CreativeMode" value="Player" />
			<property name="CustomIcon" value="DementiveStationDewCollector" />
			<property name="DescriptionKey" value="DementiveStationDewCollectorDesc" />
			<property name="EconomicValue" value="3000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="OutputTypes" value="{water,jar,1,1,1,drinkJarRiverWater,drinkJarBoiledWater,2,3,4000,7000,collector_complete_item}" />
		</block>
		<block name="DementiveStationApiary">
