			<property name="EconomicValue" value="3000" />
			<property name="TraderStageTemplate" value="baseTier2" />
			<property name="OutputTypes" value="{egg,feed,2,2,2,foodEgg,foodEgg,2,2,16000,16000,coop_eggs_complete}{feather,feed,2,2,2,resourceFeather,resourceFeather,2,2,16000,16000,coop_feathers_complete}{chicken,feed,30,0,2,domesticatedChicken,domesticatedChicken,2,1,72000,72000,coop_chicken_complete}" />
			<property name="CatalystMultiplier" value="egg=3,feather=5,chicken=0" />
		</block>
	</append>
</configs>
