<!-- Apple Mega Crush: the search time cut of the vanilla helmets that have one (their tiered values), so the
	     candy's cut is a share of what's left (buffs.xml). Pieces of Armor Expanded set the same cvar the same way -->
	<append xpath="/items/item[@name='armorRogueHelmet']">
		<effect_group name="Dementive search time" tiered="false">
			<triggered_effect trigger="onSelfEquipUpdate" action="ModifyCVar" cvar=".DementiveScavHelmet" operation="set" value=".02,.04,.06,.08,.1,.19"/>
			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar=".DementiveScavHelmet" operation="set" value="0"/>
		</effect_group>
	</append>
	<append xpath="/items/item[@name='armorSantaHatHelmet']">
		<effect_group name="Dementive search time" tiered="false">
			<triggered_effect trigger="onSelfEquipUpdate" action="ModifyCVar" cvar=".DementiveScavHelmet" operation="set" value=".02,.04,.06,.08,.1,.2"/>
			<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar=".DementiveScavHelmet" operation="set" value="0"/>
		</effect_group>
	</append>
