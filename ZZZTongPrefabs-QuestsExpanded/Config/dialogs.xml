<Dementive>

	<!-- Contracts (ContractsDEM in QuestsExpanded.dll): start one, check on it, pick boons and cash out at any trader -->
	<insertBefore xpath="/dialogs/dialog[@id='trader']/statement[@id='start']/response_entry[@id='done']">
		<response_entry id="dementiveContract"/>
	</insertBefore>

	<append xpath="/dialogs/dialog[@id='trader']">
		<statement id="dementiveContract" text="dialog_dementive_contract_statement">
			<response_entry id="dementiveContractStart"/>
			<response_entry id="dementiveContractStatus"/>
			<response_entry id="dementiveContractBoons"/>
			<response_entry id="dementiveContractCashOut"/>
			<response_entry id="nevermind"/>
		</statement>

		<statement id="dementiveContractBoons" text="dialog_dementive_contract_boons_statement">
			<response_entry id="dementiveBoon_deadeye"/>
			<response_entry id="dementiveBoon_bloodthirst"/>
			<response_entry id="dementiveBoon_secondwind"/>
			<response_entry id="dementiveBoon_scavenger"/>
			<response_entry id="dementiveBoon_ironhide"/>
			<response_entry id="dementiveBoon_fleetfoot"/>
			<response_entry id="dementiveBoon_regeneration"/>
			<response_entry id="dementiveBoon_glasscannon"/>
			<response_entry id="dementiveBoon_adrenaline"/>
			<response_entry id="dementiveBoon_juggernaut"/>
			<response_entry id="dementiveContractBack"/>
		</statement>

		<response id="dementiveContract" text="dialog_dementive_contract_response" nextstatementid="dementiveContract"/>

		<response id="dementiveContractStart" text="dialog_dementive_contract_start" nextstatementid="start">
			<requirement type="ContractDEM, QuestsExpanded" id="none" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="start"/>
		</response>

		<response id="dementiveContractStatus" text="dialog_dementive_contract_status" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="active" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="status"/>
		</response>

		<response id="dementiveContractBoons" text="dialog_dementive_contract_boons" nextstatementid="dementiveContractBoons">
			<requirement type="ContractDEM, QuestsExpanded" id="offer" requirementtype="Hide"/>
		</response>

		<response id="dementiveContractCashOut" text="dialog_dementive_contract_cashout" nextstatementid="start">
			<requirement type="ContractDEM, QuestsExpanded" id="cashout" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="cashout"/>
		</response>

		<response id="dementiveContractBack" text="dialog_trader_response_nevermind" nextstatementid="dementiveContract"/>

		<response id="dementiveBoon_deadeye" text="dialog_dementive_boon_deadeye" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="deadeye" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="deadeye"/>
		</response>

		<response id="dementiveBoon_bloodthirst" text="dialog_dementive_boon_bloodthirst" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="bloodthirst" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="bloodthirst"/>
		</response>

		<response id="dementiveBoon_secondwind" text="dialog_dementive_boon_secondwind" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="secondwind" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="secondwind"/>
		</response>

		<response id="dementiveBoon_scavenger" text="dialog_dementive_boon_scavenger" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="scavenger" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="scavenger"/>
		</response>

		<response id="dementiveBoon_ironhide" text="dialog_dementive_boon_ironhide" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="ironhide" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="ironhide"/>
		</response>

		<response id="dementiveBoon_fleetfoot" text="dialog_dementive_boon_fleetfoot" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="fleetfoot" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="fleetfoot"/>
		</response>

		<response id="dementiveBoon_regeneration" text="dialog_dementive_boon_regeneration" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="regeneration" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="regeneration"/>
		</response>

		<response id="dementiveBoon_glasscannon" text="dialog_dementive_boon_glasscannon" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="glasscannon" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="glasscannon"/>
		</response>

		<response id="dementiveBoon_adrenaline" text="dialog_dementive_boon_adrenaline" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="adrenaline" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="adrenaline"/>
		</response>

		<response id="dementiveBoon_juggernaut" text="dialog_dementive_boon_juggernaut" nextstatementid="dementiveContract">
			<requirement type="ContractDEM, QuestsExpanded" id="offered" value="juggernaut" requirementtype="Hide"/>
			<action type="ContractDEM, QuestsExpanded" id="pick" value="juggernaut"/>
		</response>

	</append>

</Dementive>
