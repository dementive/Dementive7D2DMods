<configs>
	<append xpath="/blockplaceholders">
		<!-- Generated by Scripts/FortificationsExpanded/gen_fortifications.py. A growing hedge stage turns into one of
		     these at random (the game swaps the placeholder when the plant grows), so a row isn't one shape. -->
		<placeholder name="DementiveFortHedgeRowYoungRandom">
			<block name="DementiveFortHedgeRowYoungA"/>
			<block name="DementiveFortHedgeRowYoungB"/>
		</placeholder>
		<placeholder name="DementiveFortHedgeRowFullRandom">
			<block name="DementiveFortHedgeRowFull"/>
			<block name="DementiveFortHedgeRowFullB"/>
			<block name="DementiveFortHedgeRowFullC"/>
		</placeholder>
	</append>
</configs>
