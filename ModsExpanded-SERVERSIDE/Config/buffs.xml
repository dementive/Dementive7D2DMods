		<!-- Thorns: worn marker. Zombies and animals that hurt the wearer with a direct attack (not burning or bleeding
		     they caused) get a hit buff for the mod's quality -->
		<buff name="buffDementiveModsThorns" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<effect_group>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsThornsWindow"/>
			</effect_group>
			<effect_group>
				<requirement name="EntityTagCompare" target="other" tags="zombie,animal"/>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit1">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit2">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="2"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit3">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="3"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit4">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="4"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit5">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="5"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" target="other" buff="buffDementiveModsThornsHit6">
					<requirement name="HasBuff" buff="buffDementiveModsThornsWindow"/>
					<requirement name="CVarCompare" cvar=".DementiveModsThornsTier" operation="Equals" value="6"/>
				</triggered_effect>
			</effect_group>
		</buff>
		<buff name="buffDementiveModsThornsWindow" hidden="true">
			<stack_type value="replace"/>
			<duration value=".2"/>
		</buff>

