		<!-- Reactive Plating: worn marker. Arms the plate whenever it isn't armed or recharging. The plate's resistance
		     blocks the hit (the attack event only fires after the damage is worked out); the attack event then starts the
		     recharge for the mod's quality and leaves a half-second guard for the rest of that attack. Damage over time
		     (burning, bleeding) never sends the attack event to buffs, so progression.xml spends the charge for those -->
		<buff name="buffDementiveModsPlating" hidden="true">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<update_rate value="1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffDementiveModsPlatingReady">
					<requirement name="!HasBuff" buff="buffDementiveModsPlatingReady,buffDementiveModsPlatingCooldown1,buffDementiveModsPlatingCooldown2,buffDementiveModsPlatingCooldown3,buffDementiveModsPlatingCooldown4,buffDementiveModsPlatingCooldown5,buffDementiveModsPlatingCooldown6"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffDementiveModsPlatingReady">
					<requirement name="!HasBuff" buff="buffDementiveModsPlatingReady,buffDementiveModsPlatingCooldown1,buffDementiveModsPlatingCooldown2,buffDementiveModsPlatingCooldown3,buffDementiveModsPlatingCooldown4,buffDementiveModsPlatingCooldown5,buffDementiveModsPlatingCooldown6"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown1">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="1"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown2">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="2"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown3">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="3"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown4">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="4"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown5">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="5"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingCooldown6">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
					<requirement name="CVarCompare" cvar=".DementiveModsPlatingTier" operation="Equals" value="6"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="AddBuff" buff="buffDementiveModsPlatingGuard">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="PlaySound" sound="metalhitmetal">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
				</triggered_effect>
				<triggered_effect trigger="onOtherAttackedSelf" action="RemoveBuff" buff="buffDementiveModsPlatingReady">
					<requirement name="HasBuff" buff="buffDementiveModsPlatingReady"/>
				</triggered_effect>
			</effect_group>
		</buff>
