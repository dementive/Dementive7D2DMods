<Dementive>

	<!-- Sunday Overalls: the food and water still to come before an item adds to it. Generated by Scripts/ArmorExpanded/gen_armor.py -->
	<append xpath="/entity_classes/entity_class[@name='playerMale']">
		<effect_group name="Dementive food before">
			<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar=".DementiveFoodBefore" operation="set" value="@$foodAmountAdd"/>
			<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar=".DementiveWaterBefore" operation="set" value="@$waterAmountAdd"/>
			<triggered_effect trigger="onSelfAction2End" action="ModifyCVar" cvar=".DementiveWaterBefore" operation="set" value="@$waterAmountAdd"/>
		</effect_group>
	</append>

</Dementive>
