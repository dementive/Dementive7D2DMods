<configs>
	<append xpath="/blocks">
		<!-- Every trap: the shared properties (TrapSettingsDEM) are WearPerUse and WornOutFraction (each use costs the trap
		     that much health; it stops at its last fraction until repaired, and powered ones blink their lamp),
		     AmmoItems / AmmoCapacity / AmmoPerUse (what it's loaded with from its radial menu, in order of use),
		     StatusTrap (levels lengthen its status instead of raising damage), UpgradeA / UpgradeB (the two level-3
		     upgrades; their names are the localization keys blockcommand_dem_up_<block>_A and _B), and PressItem /
		     PressCount (what a Salvage Hopper's Ammo Press loads into it per kill). Traps level up from their kills at
		     25, 75, 150 and 300 (+8% damage and +5% speed a level, or +10% status duration). Damage and kills are
		     credited to the player who placed the trap, like vanilla traps. -->

		<!-- ================================================================ primitive traps (no power) -->

		<!-- Grease Slick: zombies that walk through within Radius of the center are Tarred for TarSeconds, using
		     AmmoPerUse animal fat each; a zombie isn't greased again by the same slick for RegreaseSeconds. -->
		<block name="DementiveTrapGreaseSlick">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="GreaseSlickDEM, TrapsExpanded"/>
			<property name="Radius" value="0.75"/>
			<property name="TarSeconds" value="12"/>
			<property name="RegreaseSeconds" value="6"/>
			<property name="SplashSound" value="vomitimpact"/>
			<property name="AmmoItems" value="resourceAnimalFat"/>
			<property name="AmmoCapacity" value="10"/>
			<property name="AmmoPerUse" value="0.25"/>
			<property name="StatusTrap" value="true"/>
			<property name="UpgradeA" value="DeepGrease"/>
			<property name="UpgradeB" value="VolatileGrease"/>
			<property name="PressItem" value="resourceAnimalFat"/>
			<property name="PressCount" value="1"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?GreaseSlick"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="false"/>
			<property name="CanPickup" value="true"/>
			<property name="MaxDamage" value="300"/>
			<property name="EconomicValue" value="60"/>
			<property class="RepairItems">
				<property name="resourceScrapIron" value="5"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="3,8" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0010"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_traps"/>
			<property name="SoundPickup" value="trapiron_grab"/>
			<property name="SoundPlace" value="trapiron_place"/>
		</block>

		<!-- Burn Barrel: lit and put out from its radial menu. While lit it burns FuelSeconds per wood (SlowBurnFactor
		     times longer with Slow Burn) and goes out when the wood runs out; zombies within Radius (BellowsRadius with
		     Bellows) catch fire for BurnSeconds. Its fire is the mod's own (buffDementiveTrapsBurning), weaker than a
		     molotov. -->
		<block name="DementiveTrapBurnBarrel">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="BurnBarrelDEM, TrapsExpanded"/>
			<property name="Radius" value="1.5"/>
			<property name="BellowsRadius" value="2"/>
			<property name="BurnSeconds" value="8"/>
			<property name="FuelSeconds" value="20"/>
			<property name="SlowBurnFactor" value="3"/>
			<property name="LightSound" value="torch_swoosh"/>
			<property name="AmmoItems" value="resourceWood"/>
			<property name="AmmoCapacity" value="30"/>
			<property name="UpgradeA" value="Bellows"/>
			<property name="UpgradeB" value="SlowBurn"/>
			<property name="PressItem" value="resourceWood"/>
			<property name="PressCount" value="2"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?BurnBarrel"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="CanPickup" value="true"/>
			<property name="MaxDamage" value="600"/>
			<property name="EconomicValue" value="90"/>
			<property class="RepairItems">
				<property name="resourceScrapIron" value="8"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="5,12" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0011"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_traps"/>
			<property name="SoundPickup" value="trapiron_grab"/>
			<property name="SoundPlace" value="trapiron_place"/>
		</block>

		<!-- Swinging Log (two blocks tall): when a zombie is in front of it (Reach ahead, Width wide) the log swings
		     through for HitDamage (crushing) and Knockback meters to every zombie there, then takes RecockSeconds to pull
		     back. Spiked Log: SpikedDamage times the damage. Battering Log: BatteringKnockback meters, BatteringWidth
		     wide. -->
		<block name="DementiveTrapSwingingLog">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="SwingingLogDEM, TrapsExpanded"/>
			<property name="HitDamage" value="35"/>
			<property name="Knockback" value="3"/>
			<property name="RecockSeconds" value="5"/>
			<property name="Width" value="1.2"/>
			<property name="Reach" value="1.6"/>
			<property name="SpikedDamage" value="1.5"/>
			<property name="BatteringKnockback" value="6"/>
			<property name="BatteringWidth" value="1.8"/>
			<property name="SwingSound" value="SlowSwoosh"/>
			<property name="HitSound" value="treelogimpact"/>
			<property name="WearPerUse" value="2"/>
			<property name="UpgradeA" value="SpikedLog"/>
			<property name="UpgradeB" value="BatteringLog"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockHardenedMulti"/>
			<property name="Stacknumber" value="5"/>
			<property name="Material" value="Mwood_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?SwingingLog"/>
			<property name="MultiBlockDim" value="1,2,1"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="false"/>
			<property name="CanPickup" value="true"/>
			<property name="MaxDamage" value="800"/>
			<property name="EconomicValue" value="120"/>
			<property class="RepairItems">
				<property name="resourceWood" value="10"/>
			</property>
			<drop event="Harvest" name="resourceWood" count="10,25" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0012"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_traps"/>
			<property name="SoundPickup" value="trapwood_grab"/>
			<property name="SoundPlace" value="trapwood_place"/>
		</block>

		<!-- Bear Trap: snaps on the first zombie within Radius of its center: HitDamage (piercing) and held for
		     HoldSeconds (BigHoldSeconds for big zombies); then sprung until re-armed from its radial menu. Spring
		     Loader: re-arms itself after RearmSeconds. Heavy Jaws: holds for HeavyHoldSeconds, big zombies too. -->
		<block name="DementiveTrapBearTrap">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="BearTrapDEM, TrapsExpanded"/>
			<property name="Radius" value="0.55"/>
			<property name="HitDamage" value="50"/>
			<property name="HoldSeconds" value="3"/>
			<property name="BigHoldSeconds" value="1"/>
			<property name="HeavyHoldSeconds" value="5"/>
			<property name="RearmSeconds" value="15"/>
			<property name="SnapSound" value="trapdoor_trigger"/>
			<property name="RearmSound" value="spring_place"/>
			<property name="UpgradeA" value="SpringLoader"/>
			<property name="UpgradeB" value="HeavyJaws"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?BearTrap"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="false"/>
			<property name="CanPickup" value="true"/>
			<property name="MaxDamage" value="500"/>
			<property name="EconomicValue" value="110"/>
			<property class="RepairItems">
				<property name="resourceForgedIron" value="2"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="4,10" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0013"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_traps"/>
			<property name="SoundPickup" value="trapiron_grab"/>
			<property name="SoundPlace" value="trapiron_place"/>
		</block>

		<!-- Trip Bow: every FireDelay seconds shoots a loaded arrow at the first zombie in a LineWidth wide line
		     ahead, up to Range. ArrowDamage is the damage of each arrow it takes; flaming and exploding arrows work like
		     the vanilla ones. Repeater: RepeaterDelay. Long Draw: LongDrawDamage times the damage, LongDrawRange. -->
		<block name="DementiveTrapTripBow">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="TripBowDEM, TrapsExpanded"/>
			<property name="Range" value="12"/>
			<property name="LineWidth" value="1.2"/>
			<property name="FireDelay" value="3"/>
			<property name="RepeaterDelay" value="1.5"/>
			<property name="LongDrawRange" value="20"/>
			<property name="LongDrawDamage" value="1.5"/>
			<property name="ArrowDamage" value="ammoArrowStone:35,ammoArrowIron:38,ammoArrowSteelAP:42,ammoArrowFlaming:25,ammoArrowExploding:30"/>
			<property name="FireSound" value="bow_fire"/>
			<property name="AmmoItems" value="ammoArrowStone,ammoArrowIron,ammoArrowSteelAP,ammoArrowFlaming,ammoArrowExploding"/>
			<property name="AmmoCapacity" value="30"/>
			<property name="UpgradeA" value="Repeater"/>
			<property name="UpgradeB" value="LongDraw"/>
			<property name="PressItem" value="ammoArrowIron"/>
			<property name="PressCount" value="1"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Stacknumber" value="5"/>
			<property name="Material" value="Mwood_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?TripBow"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="CanPickup" value="true"/>
			<property name="MaxDamage" value="400"/>
			<property name="EconomicValue" value="140"/>
			<property class="RepairItems">
				<property name="resourceWood" value="6"/>
			</property>
			<drop event="Harvest" name="resourceWood" count="5,12" tag="allHarvest"/>
			<drop event="Destroy" count="0"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0014"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_traps"/>
			<property name="SoundPickup" value="bow_wooden_grab"/>
			<property name="SoundPlace" value="bow_wooden_place"/>
		</block>

		<!-- ================================================================ powered traps -->

		<!-- Tesla Coil: zaps the nearest zombie within Range every FireDelay seconds and jumps to Chains more within
		     ChainRange, each jump doing ChainFalloff of the last. Needs a clear path (bodies in the way still conduct).
		     Each zombie hit has JoltChance of a short jolt (JoltBuff plus the vanilla electrocute flinch). Soaked zombies
		     take SoakedDamage times the damage, the arc gets SoakedChains more jumps once it has hit one, and their jolt
		     becomes SoakedStunBuff unless they have SoakedStunImmuneBuff (big zombies get the plain jolt). Storm:
		     StormChains more jumps at StormDamage. Overload: no jumps, OverloadDamage times the damage, and every hit
		     jolts (a stun, with the same immunity). -->
		<block name="DementiveTrapTeslaCoil">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="TeslaCoilDEM, TrapsExpanded"/>
			<property name="RequiredPower" value="30"/>
			<property name="EntityDamage" value="22"/>
			<property name="Range" value="8"/>
			<property name="FireDelay" value="1.5"/>
			<property name="Chains" value="2"/>
			<property name="ChainRange" value="4"/>
			<property name="ChainFalloff" value="0.6"/>
			<property name="JoltChance" value="0.1"/>
			<property name="JoltBuff" value="buffDementiveTrapsJolt"/>
			<property name="SoakedDamage" value="2"/>
			<property name="SoakedChains" value="1"/>
			<property name="SoakedStunBuff" value="buffDementiveTrapsStun"/>
			<property name="SoakedStunImmuneBuff" value="buffDementiveTrapsStunImmune"/>
			<property name="StormChains" value="2"/>
			<property name="StormDamage" value="0.8"/>
			<property name="OverloadDamage" value="2.5"/>
			<property name="WearPerUse" value="1"/>
			<property name="WornOutFraction" value="0.05"/>
			<property name="UpgradeA" value="Storm"/>
			<property name="UpgradeB" value="Overload"/>
			<property name="ZapSound" value="electric_fence_impact"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockElectricalHardenedMulti"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_hard"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?TeslaCoil"/>
			<property name="MultiBlockDim" value="1,2,1"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="1000"/>
			<property name="EconomicValue" value="1200"/>
			<property name="TraderStageTemplate" value="electricTier2"/>
			<property name="TakeDelay" value="10"/>
			<property class="RepairItems">
				<property name="resourceForgedSteel" value="6"/>
				<property name="resourceElectricParts" value="4"/>
			</property>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceElectricParts" count="2,5" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMechanicalParts" count="1,2" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceScrapIron" count="20,60" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0025"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill,scrap100"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical,SC_traps"/>
			<property name="SoundPickup" value="darttrap_grab"/>
			<property name="SoundPlace" value="darttrap_place"/>
		</block>

		<!-- Sprinkler: every PulseDelay seconds sprays a ConeAngle cone up to Range ahead of its nozzles and soaks
		     every enemy the water can reach with SoakBuff for SoakSeconds. It only sprays when there's someone to soak.
		     The nozzles face the way the block is turned. Deluge: DelugeAngle cone, DelugeSeconds soak. Pressure Washer:
		     a WasherAngle jet that shoves zombies WasherShove meters for WasherDamage. -->
		<block name="DementiveTrapSprinkler">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="SprinklerDEM, TrapsExpanded"/>
			<property name="RequiredPower" value="5"/>
			<property name="Range" value="6"/>
			<property name="ConeAngle" value="60"/>
			<property name="PulseDelay" value="1"/>
			<property name="SoakBuff" value="buffDementiveTrapsSoaked"/>
			<property name="SoakSeconds" value="10"/>
			<property name="SpraySound" value="bucketbail_water"/>
			<property name="DelugeAngle" value="90"/>
			<property name="DelugeSeconds" value="20"/>
			<property name="WasherAngle" value="20"/>
			<property name="WasherShove" value="1"/>
			<property name="WasherDamage" value="15"/>
			<property name="StatusTrap" value="true"/>
			<property name="UpgradeA" value="Deluge"/>
			<property name="UpgradeB" value="PressureWasher"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockElectricalHardened"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?Sprinkler"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="500"/>
			<property name="EconomicValue" value="400"/>
			<property name="TraderStageTemplate" value="electricTier1"/>
			<property name="TakeDelay" value="5"/>
			<property class="RepairItems">
				<property name="resourceScrapPolymers" value="4"/>
				<property name="resourceMetalPipe" value="1"/>
			</property>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceScrapPolymers" count="3,6" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMetalPipe" count="1" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMechanicalParts" count="1" tag="salvageHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0026"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical,SC_traps"/>
			<property name="SoundPickup" value="darttrap_grab"/>
			<property name="SoundPlace" value="darttrap_place"/>
		</block>

		<!-- Tar Sprayer: every FireDelay seconds lobs a tar glob at the nearest zombie within Range it can reach:
		     HitDamage to every zombie within Splash meters of where it lands, all of them Tarred for TarSeconds, using
		     AmmoPerUse tar a glob. Sticky Tar: 60% slower. Volatile Tar: Infernos 50% stronger, spreading 5 m. -->
		<block name="DementiveTrapTarSprayer">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="TarSprayerDEM, TrapsExpanded"/>
			<property name="RequiredPower" value="5"/>
			<property name="Range" value="10"/>
			<property name="FireDelay" value="2"/>
			<property name="HitDamage" value="5"/>
			<property name="Splash" value="2"/>
			<property name="TarSeconds" value="12"/>
			<property name="FireSound" value="darttrap_fire"/>
			<property name="SplatSound" value="vomitimpact"/>
			<property name="AmmoItems" value="DementiveTrapTar"/>
			<property name="AmmoCapacity" value="40"/>
			<property name="AmmoPerUse" value="0.25"/>
			<property name="StatusTrap" value="true"/>
			<property name="UpgradeA" value="StickyTar"/>
			<property name="UpgradeB" value="VolatileTar"/>
			<property name="PressItem" value="DementiveTrapTar"/>
			<property name="PressCount" value="1"/>
			<property name="UnlockedBy" value="craftingTraps"/>
			<property name="DisplayType" value="blockElectricalHardened"/>
			<property name="Stacknumber" value="10"/>
			<property name="Material" value="Mmetal_weak"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#@modfolder:Resources/trapsexpanded.unity3d?TarSprayer"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="HandleFace" value="Bottom"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="Path" value="solid"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="600"/>
			<property name="EconomicValue" value="450"/>
			<property name="TraderStageTemplate" value="electricTier1"/>
			<property name="TakeDelay" value="5"/>
			<property class="RepairItems">
				<property name="resourceForgedIron" value="3"/>
				<property name="resourceMechanicalParts" value="1"/>
			</property>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceMechanicalParts" count="1,2" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceScrapIron" count="10,25" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B155"/>
			<property name="SortOrder2" value="0027"/>
			<property name="Group" value="Science,TCScience"/>
			<property name="Tags" value="trapsSkill"/>
