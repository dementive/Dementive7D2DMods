			<item name="DementiveClothingMountaineer" loot_prob_template="DementiveClothingTier3"/>
			<item name="DementiveClothingWoolSocks"/>
			<item name="DementiveClothingGumBoots" loot_prob_template="DementiveClothingTier2"/>
			<item name="DementiveClothingHiking" loot_prob_template="DementiveClothingTier2"/>
			<item name="DementiveClothingDesert" loot_prob_template="DementiveClothingTier2"/>
			<item name="DementiveClothingSnow" loot_prob_template="DementiveClothingTier3"/>
