	<!-- *** Named clothing (Scripts/ArmorExpanded/clothing.py) -->
	<append xpath="/traders/traderstage_templates">
		<!-- Named clothing: the vanilla clothing tiers' trader stages (1, 25 and 55), but for quality 1-6 (the vanilla ones
		     only list quality 0, which no quality 1-6 trader item matches) -->
		<traderstage_template name="dementiveClothingTier1">
			<entry min="1" max="999999" quality="0"/>
			<entry min="1" max="999999" quality="1"/>
			<entry min="1" max="999999" quality="2"/>
			<entry min="1" max="999999" quality="3"/>
			<entry min="1" max="999999" quality="4"/>
			<entry min="1" max="999999" quality="5"/>
			<entry min="1" max="999999" quality="6"/>
		</traderstage_template>
		<traderstage_template name="dementiveClothingTier2">
			<entry min="25" max="999999" quality="0"/>
